# SOC Analyst Automation Platform - Environment Variables
# Copy this file to .env and fill in your API keys

# REQUIRED: Anthropic API Key for Claude Opus
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OPTIONAL: VirusTotal API Key for hash/IP lookups
VIRUSTOTAL_API_KEY=your-vt-key-here

# OPTIONAL: AbuseIPDB API Key for IP reputation
ABUSEIPDB_API_KEY=your-abuseipdb-key-here
